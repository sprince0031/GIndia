<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="bgGrad_sikkim-large-cardamom" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#14532D" />
      <stop offset="50%" stop-color="#052E16" />
      <stop offset="100%" stop-color="#14532D" />
    </linearGradient>
    <radialGradient id="spotlight_sikkim-large-cardamom" cx="50%" cy="45%" r="55%">
      <stop offset="0%" stop-color="#22C55E" stop-opacity="0.45" />
      <stop offset="60%" stop-color="#22C55E" stop-opacity="0.1" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="floorShadow_sikkim-large-cardamom" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="rgba(0,0,0,0.6)" />
      <stop offset="100%" stop-color="rgba(0,0,0,0)" />
    </radialGradient>
  </defs>

  <!-- Ambient Gallery Plate Canvas -->
  <rect width="100%" height="100%" fill="url(#bgGrad_sikkim-large-cardamom)"/>
  <rect width="100%" height="100%" fill="url(#spotlight_sikkim-large-cardamom)"/>

  <!-- Museum Exhibition Grid & Aura -->
  <circle cx="300" cy="180" r="140" fill="none" stroke="#FACC15" stroke-opacity="0.12" stroke-width="1.5" />
  <circle cx="300" cy="180" r="115" fill="none" stroke="#FACC15" stroke-opacity="0.08" stroke-width="1" stroke-dasharray="6,6" />

  <!-- Pedestal Floor Drop Shadow -->
  <ellipse cx="300" cy="285" rx="140" ry="25" fill="url(#floorShadow_sikkim-large-cardamom)" />

  <!-- HERO PHYSICAL OBJECT ILLUSTRATION -->
  <g transform="translate(300, 180)">
    
        <!-- Heritage Craft Artifact Display -->
        <circle cx="0" cy="0" r="65" fill="#CA8A04" opacity="0.2" filter="drop-shadow(0 0 20px rgba(234,179,8,0.4))" />
        <!-- Royal Medal Emblem -->
        <polygon points="0,-60 18,-20 60,-20 28,10 40,55 0,28 -40,55 -28,10 -60,-20 -18,-20" fill="#EAB308" stroke="#CA8A04" stroke-width="3" filter="drop-shadow(0 10px 15px rgba(0,0,0,0.4))" />
        <circle cx="0" cy="0" r="28" fill="#78350F" />
        <circle cx="0" cy="0" r="22" fill="#FDE047" />
        <path d="M-10,0 L0,-12 L10,0 L0,12 Z" fill="#991B1B" />
      
  </g>

  <!-- Curatorial Caption Bar -->
  <rect x="0" y="325" width="600" height="75" fill="rgba(15, 23, 42, 0.75)" />
  <rect x="0" y="325" width="600" height="1" fill="rgba(255, 255, 255, 0.12)" />

  <text x="32" y="358" fill="#F9F6F0" font-family="'Playfair Display', Georgia, serif" font-size="20" font-weight="700">
    Sikkim Large Cardamom
  </text>
  
  <text x="32" y="382" fill="rgba(249, 246, 240, 0.7)" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="500">
    Sikkim • Registered Geographical Indication of India
  </text>

  <!-- Accent Corner Tag -->
  <rect x="0" y="396" width="600" height="4" fill="#FACC15" />
</svg>