<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="bgGrad_bikaneri-bhujia" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7C2D12" />
      <stop offset="50%" stop-color="#431407" />
      <stop offset="100%" stop-color="#7C2D12" />
    </linearGradient>
    <radialGradient id="spotlight_bikaneri-bhujia" cx="50%" cy="45%" r="55%">
      <stop offset="0%" stop-color="#EA580C" stop-opacity="0.45" />
      <stop offset="60%" stop-color="#EA580C" stop-opacity="0.1" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="floorShadow_bikaneri-bhujia" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="rgba(0,0,0,0.6)" />
      <stop offset="100%" stop-color="rgba(0,0,0,0)" />
    </radialGradient>
  </defs>

  <!-- Ambient Gallery Plate Canvas -->
  <rect width="100%" height="100%" fill="url(#bgGrad_bikaneri-bhujia)"/>
  <rect width="100%" height="100%" fill="url(#spotlight_bikaneri-bhujia)"/>

  <!-- Museum Exhibition Grid & Aura -->
  <circle cx="300" cy="180" r="140" fill="none" stroke="#FDE047" stroke-opacity="0.12" stroke-width="1.5" />
  <circle cx="300" cy="180" r="115" fill="none" stroke="#FDE047" stroke-opacity="0.08" stroke-width="1" stroke-dasharray="6,6" />

  <!-- Pedestal Floor Drop Shadow -->
  <ellipse cx="300" cy="285" rx="140" ry="25" fill="url(#floorShadow_bikaneri-bhujia)" />

  <!-- HERO PHYSICAL OBJECT ILLUSTRATION -->
  <g transform="translate(300, 180)">
    
        <!-- Traditional brass bowl filled with crispy moth-bean crisp sev -->
        <ellipse cx="0" cy="55" rx="75" ry="18" fill="rgba(0,0,0,0.4)" />
        <path d="M-65,15 Q-75,60 0,65 Q75,60 65,15 Z" fill="#B45309" />
        <path d="M-60,18 Q-70,55 0,60 Q70,55 60,18 Z" fill="#F59E0B" />
        <!-- Mounded golden crisp noodles -->
        <ellipse cx="0" cy="15" rx="60" ry="20" fill="#FBBF24" />
        <g stroke="#D97706" stroke-width="2.5" stroke-linecap="round" fill="none">
          <path d="M13.4,-4.4 Q19.9,-9.2 20.7,1.9" /><path d="M-13.9,1.8 Q-6.9,-8.5 -12.3,-2.7" /><path d="M-14.8,-9.6 Q-12.5,-17.4 -13.5,-9.3" /><path d="M-35.1,8.2 Q-29.9,1.7 -24.9,11.2" /><path d="M-26.0,14.2 Q-22.3,2.5 -31.9,6.8" /><path d="M22.0,23.3 Q13.0,14.5 11.5,21.7" /><path d="M17.5,17.0 Q22.9,5.7 22.6,10.4" /><path d="M-6.6,8.3 Q-3.6,5.1 -12.5,17.9" /><path d="M-23.3,20.9 Q-25.1,8.5 -33.3,12.1" /><path d="M19.2,18.9 Q18.4,11.0 27.0,19.1" /><path d="M2.1,9.2 Q5.0,1.6 8.3,10.0" /><path d="M18.2,18.6 Q18.5,9.4 28.2,16.2" /><path d="M-7.3,16.1 Q-2.1,10.3 2.4,20.6" /><path d="M-18.1,0.3 Q-16.7,-10.2 -19.6,-4.7" /><path d="M-16.8,8.4 Q-6.3,5.4 -6.6,18.3" /><path d="M-17.6,13.1 Q-10.9,9.2 -17.3,21.2" /><path d="M-42.9,-1.9 Q-48.5,-13.9 -53.2,-9.8" /><path d="M12.1,14.9 Q15.0,10.5 17.1,22.1" /><path d="M36.8,-8.6 Q28.4,-19.5 28.7,-14.3" /><path d="M-19.0,-7.3 Q-14.0,-10.8 -13.6,1.7" /><path d="M44.2,-5.1 Q54.2,-12.9 56.5,-4.6" /><path d="M-42.0,16.2 Q-38.8,10.6 -33.1,21.1" /><path d="M-9.4,2.4 Q-3.9,-10.0 -0.0,-6.4" /><path d="M-10.0,12.1 Q-12.9,2.0 -20.6,7.9" /><path d="M-44.6,19.5 Q-39.6,11.9 -40.7,20.2" /><path d="M11.6,-1.9 Q13.2,-6.9 15.0,4.2" /><path d="M14.3,13.3 Q27.2,6.3 25.6,15.3" /><path d="M-31.0,-4.7 Q-21.5,-14.7 -19.0,-8.7" /><path d="M10.1,2.6 Q-0.7,-4.3 -1.2,4.7" /><path d="M-14.3,-9.6 Q-0.8,-19.6 -2.3,-13.6" /><path d="M-27.5,15.1 Q-33.4,4.6 -35.7,10.1" /><path d="M40.9,21.1 Q45.2,14.3 46.9,23.4" /><path d="M-18.0,18.1 Q-17.6,8.6 -13.4,15.1" /><path d="M-0.1,-9.7 Q-4.1,-21.4 -0.7,-17.2" /><path d="M-26.0,21.1 Q-31.2,11.3 -24.3,17.6" /><path d="M30.3,1.0 Q34.3,-10.5 23.9,-6.0" /><path d="M-0.7,2.3 Q6.0,-5.0 2.8,3.7" /><path d="M-19.4,1.5 Q-17.3,-4.6 -12.1,5.3" /><path d="M15.9,9.2 Q22.0,2.4 19.2,11.5" /><path d="M22.3,3.5 Q32.3,-2.8 33.8,6.8" />
        </g>
        <!-- Black pepper specks -->
        <circle cx="36.3" cy="2.5" r="1.5" fill="#18181B" /><circle cx="-8.5" cy="16.7" r="1.5" fill="#18181B" /><circle cx="39.9" cy="9.3" r="1.5" fill="#18181B" /><circle cx="-23.2" cy="1.0" r="1.5" fill="#18181B" /><circle cx="-9.2" cy="5.0" r="1.5" fill="#18181B" /><circle cx="-22.4" cy="9.5" r="1.5" fill="#18181B" /><circle cx="7.8" cy="-1.5" r="1.5" fill="#18181B" /><circle cx="21.9" cy="4.8" r="1.5" fill="#18181B" /><circle cx="3.1" cy="16.9" r="1.5" fill="#18181B" /><circle cx="-27.4" cy="7.9" r="1.5" fill="#18181B" /><circle cx="20.1" cy="-4.8" r="1.5" fill="#18181B" /><circle cx="-31.1" cy="18.3" r="1.5" fill="#18181B" /><circle cx="-3.1" cy="28.9" r="1.5" fill="#18181B" /><circle cx="27.3" cy="-1.5" r="1.5" fill="#18181B" /><circle cx="-5.0" cy="3.4" r="1.5" fill="#18181B" /><circle cx="15.0" cy="25.7" r="1.5" fill="#18181B" /><circle cx="-29.6" cy="12.2" r="1.5" fill="#18181B" /><circle cx="-18.5" cy="17.0" r="1.5" fill="#18181B" /><circle cx="32.1" cy="29.0" r="1.5" fill="#18181B" /><circle cx="-12.9" cy="16.3" r="1.5" fill="#18181B" />
      
  </g>

  <!-- Curatorial Caption Bar -->
  <rect x="0" y="325" width="600" height="75" fill="rgba(15, 23, 42, 0.75)" />
  <rect x="0" y="325" width="600" height="1" fill="rgba(255, 255, 255, 0.12)" />

  <text x="32" y="358" fill="#F9F6F0" font-family="'Playfair Display', Georgia, serif" font-size="20" font-weight="700">
    Bikaneri Bhujia
  </text>
  
  <text x="32" y="382" fill="rgba(249, 246, 240, 0.7)" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="500">
    Rajasthan • Registered Geographical Indication of India
  </text>

  <!-- Accent Corner Tag -->
  <rect x="0" y="396" width="600" height="4" fill="#FDE047" />
</svg>